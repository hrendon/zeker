# Environment variables (NEVER commit .env files)
.env
.env.local
.env.*.local

# Node.js
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log

# package-lock.json is deliberately NOT ignored. It pins the exact version of
# every library, so the code that runs in production is the code that was
# tested. Ignoring it lets two builds of the same commit differ.
yarn.lock
pnpm-lock.yaml

# Next.js
.next/
out/
.vercel/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
.DS_Store
.env.local
.env.*.local

# Build outputs
dist/
build/

# Temporary files
*.tmp
.cache/
temp/

# GCP — credential files must never be committed.
# Authentication uses Application Default Credentials (no key file), but any
# key file that ends up in the working tree is blocked here regardless.
google-cloud-key.json
service-account.json
gcp-service-account-key.json
*-service-account*.json
*serviceaccount*.json
application_default_credentials.json
*.json.example

# Firebase
firebase-debug.log
