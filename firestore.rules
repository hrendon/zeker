rules_version = '2';

// Zeker — Firestore Security Rules
//
// Decision 004 (docs/decisions/004-backend-only-firestore-access.md):
// Clients never reach Firestore directly. Every read and write goes through
// the Zeker backend, which uses the Firebase Admin SDK (Admin SDK bypasses
// these rules by design) and enforces organization membership on every
// request.
//
// Multi-tenant isolation is therefore enforced in the backend, not here.
// This file's only job is to make sure there is no second, unguarded path
// to the data from a browser holding the public Firebase web config.
//
// A granular per-role rule set is kept as a reference design in
// docs/architecture/data-model.md. It is NOT in force.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
