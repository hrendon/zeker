# ================================================
# Zeker MVP — Environment Configuration Template
# ================================================
#
# ADC (Application Default Credentials) handles GCP authentication.
# No service account JSON key file needed.
#
# Local dev setup:
#   gcloud auth application-default login
#
# ================================================

# GCP Project
GCP_PROJECT_ID=zeker-505918
FIRESTORE_PROJECT_ID=zeker-505918

# Cloud KMS (for encryption at rest)
KMS_LOCATION=us-central1
KMS_KEY_RING=zeker-keys
KMS_KEY_NAME=zeker-encryption-key

# Firebase Client Configuration
# Get these from: https://console.firebase.google.com/project/zeker-505918/settings/general
# Under "Firebase SDK snippet"
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDT5TBp30GSbj_VdmoK3IH9E3k2JYUocv4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zeker-505918.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zeker-505918
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zeker-505918.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=880033266233
NEXT_PUBLIC_FIREBASE_APP_ID=1:880033266233:web:1ef97839b90331fe3febe8

# Application Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
