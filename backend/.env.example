# Backend configuration template. Copy to .env for local development.
#
# GCP authentication uses Application Default Credentials — there is no key
# file and no secret in this file. Run once:
#   gcloud auth application-default login

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# GCP project. Required only when NODE_ENV=production.
GCP_PROJECT_ID=zeker-505918

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
