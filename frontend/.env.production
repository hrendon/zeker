# ================================================
# Frontend Environment — production build
# ================================================
#
# Next compiles NEXT_PUBLIC_* values into the browser bundle at build time, so
# they must exist when `next build` runs — setting them on Cloud Run afterwards
# would do nothing. They live here, tracked, so a build from a fresh clone
# produces the same bundle.
#
# These are PUBLIC values, the same ones every visitor's browser already
# receives. The Firebase web key identifies the project; it does not grant
# access. What protects the data is the deny-all Firestore rule (Decision 004)
# and Firebase Auth — not the secrecy of this file.
#
# ================================================

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDT5TBp30GSbj_VdmoK3IH9E3k2JYUocv4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zeker-505918.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zeker-505918
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zeker-505918.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=880033266233
NEXT_PUBLIC_FIREBASE_APP_ID=1:880033266233:web:1ef97839b90331fe3febe8

# The deployed API
NEXT_PUBLIC_API_URL=https://zeker-api-880033266233.us-central1.run.app

NEXT_PUBLIC_ENV=production
